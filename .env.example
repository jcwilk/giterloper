# Giterloper MCP — committed env template. Copy to a gitignored local file and edit:
#   .env.dev  — day-to-day (default tasks use this; see deno.json / git-ej14)
#   .env.test — MCP test mode (GITERLOPER_MCP_TEST_MODE + TEST_KNOWLEDGE_STORE_REMOTE)
# Normative variable names and semantics: specs/MCP.md.

# --- Normal mode (default / .env.dev) ---
# Required at MCP server startup: non-empty valid Git remote URL for the knowledge store.
KNOWLEDGE_STORE_REMOTE=https://github.com/owner/your-knowledge-repo.git

# --- MCP test mode (use in .env.test instead of the block above) ---
# When GITERLOPER_MCP_TEST_MODE is truthy, the server uses .giterloper_test and
# requires TEST_KNOWLEDGE_STORE_REMOTE instead of KNOWLEDGE_STORE_REMOTE.
# GITERLOPER_MCP_TEST_MODE=1
# TEST_KNOWLEDGE_STORE_REMOTE=https://github.com/owner/your-test-knowledge-repo.git

# --- HTTP authentication (specs/MCP.md — Authentication) ---
# Unless MCP_INSECURE is enabled for local dev only, HTTP requests must send
# Authorization: Bearer <token> matching this value.
# MCP_TOKEN=

# --- Optional operator hints (not normative in specs/MCP.md) ---
# See AGENTS.md and docs/ (e.g. docs/DEPLOYMENT_REQUIREMENTS.md) for details.
# MCP_INSECURE=true
# GITERLOPER_GH_TOKEN=
# MCP_PORT=3443
# MCP_HOST=127.0.0.1
