KNOWLEDGE_STORE_REMOTE=
TEST_KNOWLEDGE_STORE_REMOTE=

# OpenAI API key for memsearch embeddings (index build / giterloper_search). Required when
# memsearch uses the default OpenAI embedder; omit only if your memsearch config uses another provider.
OPENAI_API_KEY=

# Reconcile (gl reconcile / giterloper_reconcile_pending): OpenAI Chat Completions for LLM integration.
# Optional overrides; OPENAI_API_KEY is used when GITERLOPER_RECONCILE_OPENAI_API_KEY is unset.
# GITERLOPER_RECONCILE_LLM_TEST_STUB=1 is for automated tests only (not production).
# GITERLOPER_RECONCILE_OPENAI_API_KEY=
# GITERLOPER_RECONCILE_OPENAI_MODEL=gpt-4o-mini
# GITERLOPER_RECONCILE_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Perplexity Sonar (web-research Task subagent, `.cursor/agents/web-research.md`). Not used by gl/MCP.
# PERPLEXITY_API_KEY=
