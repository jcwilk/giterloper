{
  "tasks": {
    "check": "deno run -A scripts/check-all.ts",
    "test": "deno run -A scripts/run-tests.ts",
    "test:core": "deno test -A --parallel tests/core/",
    "test:pin-semantics": "deno test -A --parallel tests/pin-semantics/",
    "test:cli": "deno test -A tests/cli/",
    "test:mcp": "deno test -A tests/mcp/",
    "mcp:serve": "deno run -A scripts/with-memsearch.ts -- run -A --env-file=.env lib/gl-mcp-server.ts",
    "mcp:serve-stdio": "deno run -A scripts/with-memsearch.ts -- run -A --env-file=.env lib/gl-mcp-server-stdio.ts",
    "mcp:serve:test": "deno run -A scripts/with-memsearch.ts -- run -A --env-file=.env lib/gl-mcp-server.ts --mcp-test-mode",
    "mcp:serve-stdio:test": "deno run -A scripts/with-memsearch.ts -- run -A --env-file=.env lib/gl-mcp-server-stdio.ts --mcp-test-mode"
  },
  "imports": {
    "@swc/wasm": "npm:@swc/wasm@1.10.18",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.27.1",
    "hono": "npm:hono@^4.11.4",
    "zod": "npm:zod@^3.25.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "deno.unstable", "dom"]
  },
}
